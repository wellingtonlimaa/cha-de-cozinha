# ────────────────────────────────────────────────────────────
# Credenciais Supabase (obrigatórias)
# Pegue em: Supabase Dashboard → Project Settings → API
# IMPORTANTE: use a chave PUBLISHABLE / anon, NUNCA a service_role.
# ────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx

# ────────────────────────────────────────────────────────────
# Painel administrativo (opcional)
# Senha que os noivos usam para acessar /admin (#/admin no navegador).
# Defina algo só vocês saberem. Se vazio, o painel fica indisponível.
# ────────────────────────────────────────────────────────────
VITE_ADMIN_PASSWORD=troque-esta-senha

# ────────────────────────────────────────────────────────────
# WhatsApp (opcional)
# Telefone com DDI, só dígitos. Ex.: 5511999998888 = Brasil + 11 + 99999-8888.
# Aparece como botão flutuante para os convidados tirarem dúvidas.
# Se vazio, o botão não aparece.
# ────────────────────────────────────────────────────────────
VITE_WHATSAPP_NUMBER=
