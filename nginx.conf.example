# =============================================================
# Exemplo de configuração nginx para o site Chá de Cozinha.
# Copie para /etc/nginx/sites-available/cha-de-cozinha
# e ajuste:
#   - server_name (seu domínio)
#   - root        (caminho da pasta dist/)
# =============================================================

# Redireciona HTTP -> HTTPS (descomente depois de configurar SSL)
# server {
#   listen 80;
#   listen [::]:80;
#   server_name chadecozinha.seudominio.com;
#   return 301 https://$host$request_uri;
# }

server {
  listen 80;
  listen [::]:80;
  # Quando configurar HTTPS via certbot, ele troca pra:
  # listen 443 ssl http2;
  # listen [::]:443 ssl http2;

  server_name chadecozinha.seudominio.com;

  root /var/www/cha-de-cozinha/dist;
  index index.html;

  # Compressão
  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types
    application/javascript
    application/json
    application/xml
    image/svg+xml
    text/css
    text/javascript
    text/plain
    text/xml;

  # Tamanho máximo de upload (não usamos, mas útil ter)
  client_max_body_size 4M;

  # Headers de segurança básicos
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

  # ── Assets com hash: cache longo (1 ano) ──────────────────────
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # ── Outros estáticos: cache moderado ──────────────────────────
  location ~* \.(?:ico|svg|png|jpg|jpeg|gif|webp|woff2?|ttf|eot)$ {
    add_header Cache-Control "public, max-age=2592000" always; # 30 dias
    try_files $uri =404;
  }

  # ── index.html: nunca em cache (precisa pegar versão nova) ────
  location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    expires off;
  }

  # ── SPA fallback: qualquer rota cai no index.html ────────────
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Bloqueia acesso a arquivos sensíveis
  location ~ /\.(?!well-known) {
    deny all;
  }

  # Logs
  access_log /var/log/nginx/cha-de-cozinha.access.log;
  error_log  /var/log/nginx/cha-de-cozinha.error.log;
}
